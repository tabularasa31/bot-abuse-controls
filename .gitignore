# TLS material — generate locally with openssl
infra/nginx-lua-poc/certs/*.pem
infra/nginx-lua-poc/certs/*.key
infra/nginx-lua-poc/certs/*.crt
infra/nginx-lua-poc/spikes/*/certs/*.pem
infra/nginx-lua-poc/spikes/*/certs/*.key
infra/nginx-lua-poc/spikes/*/certs/*.crt
infra/nginx-shadow/certs/*.pem
infra/nginx-shadow/certs/*.key
infra/nginx-shadow/certs/*.crt

# Local env
.env
.env.local
.env.report

# Mac
.DS_Store

# Go build artifacts (in case antibot/ gets compiled locally)
antibot/antibot
antibot/*.test
*.out

# Docker logs / volumes
docker-compose.override.yml
infra/demo-stand/certs/*.pem
infra/demo-stand/certs/*.key
infra/demo-stand/certs/*.crt

# GeoLite2 databases — license-gated (MaxMind), fetched via
# infra/demo-stand/scripts/fetch-geoip.sh, not committed. Keep the dir.
infra/demo-stand/geoip/*.mmdb

# Runtime state on the VM (analytics, update-loop bookkeeping)
/state/
# Live deployed sha written by scripts/update.sh, served by /__version
infra/demo-stand/lua/.revision
# Analyzer report archive (per-day markdown)
/reports/

# Kill-switch operator override (A12) — operational state, not code. The
# committed kill_switch.local.conf.example is the template; the live file is
# dropped on the VM and flipped per incident, never committed.
infra/demo-stand/config/kill_switch.local.conf

# Python
__pycache__/
*.pyc
