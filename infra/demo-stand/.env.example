# Copy to .env on the edge VM and fill in. .env is gitignored — never
# commit real secrets.

# ─── Proxied tenants ──────────────────────────────────────────────────────
# There is no origin env var. The stand is a multi-tenant SaaS edge: a tenant
# is a host whose Policy (Channel C) carries a non-empty origin_ip. Register
# one with a single call to the backend Policy API, e.g.
#   PATCH /antibot/v1/policy/clientx.com {"mode":"active","origin_ip":"203.0.113.9"}
# The edge then proxies Host: clientx.com to 203.0.113.9 (loop-safe; Host/SNI
# upstream stay clientx.com). Any host without a tenant origin_ip gets the
# bundled BAC landing page (the cascade still runs). See ClickUp 86exrefdz.

# ─── Bind / identity ──────────────────────────────────────────────────────
# Per-stack bind IP. Default 0.0.0.0; on a VM that shares a host with the
# antibot-backend stack, set to the demo's dedicated IP so :443 doesn't
# clash.
DEMO_BIND_IP=

# edge_id stamped into every BAC log record (bac_log.lua).
EDGE_ID=stand-bac

# ─── Channel C — catalog pulls to the antibot-backend ─────────────────────
# Optional. Empty = catalog_pull skips the timer, stand runs on its static
# seed. With a URL it pulls every 30s through the LB-nginx mTLS gate.
ANTIBOT_BACKEND_URL=
ANTIBOT_BACKEND_HOST=
ANTIBOT_BACKEND_CLIENT_CERT=
ANTIBOT_BACKEND_CLIENT_KEY=
# Demo backend uses a self-signed cert, so leave this blank or "false"
# until you mount a real CA bundle.
ANTIBOT_BACKEND_SSL_VERIFY=

# ─── BAC log viewer — promtail (`observability` profile) ──────────────────
# Edge → backend Loki push endpoint. Goes through the same LB-nginx +
# mTLS path as catalog pulls. Empty = promtail won't ship anything; bring
# the stand up without --profile observability to skip the service
# entirely.
#   docker compose -f docker-compose.demo.yml --profile observability up -d
LOKI_PUSH_URL=

# Skip TLS-verification of the backend's server cert. Default true matches
# the gen-certs.sh self-signed demo path. Set to false and mount a backend
# CA bundle for a prod-grade chain.
LOKI_PUSH_INSECURE_TLS=true
