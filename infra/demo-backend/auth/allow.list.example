# [B6] allow-list for AUTH_MODE=ip-allowlist. Copied to allow.list by
# scripts/provision.sh on first run; edit allow.list directly afterwards and
# `docker compose exec lb nginx -s reload` to apply.
#
# По умолчанию пускаем loopback (acceptance verify.sh бьёт по https://localhost)
# и RFC1918-диапазоны (типичный egress эджей в private-сети демо-VM). Для prod —
# заменить на конкретный egress-range prod-edge (config-distribution §Channel C
# "Auth/transport: ... IP allowlist from CDN operator's egress range").

# Loopback (verify.sh, локальные curl'ы на самой backend-VM).
allow 127.0.0.1;
allow ::1;

# RFC1918 (docker bridge сети, edge-VM в той же private сети).
allow 10.0.0.0/8;
allow 172.16.0.0/12;
allow 192.168.0.0/16;

# Prod: добавь сюда конкретный CIDR egress'а prod-edge эджей и удали RFC1918,
# если backend смотрит наружу.
# allow 198.51.100.0/24;
