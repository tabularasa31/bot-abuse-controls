# Copy to .env and fill in. .env is gitignored — never commit real secrets.
POSTGRES_DB=antibot
POSTGRES_USER=antibot
POSTGRES_PASSWORD=

# The shared M2M secret for bearer auth between the dashboard backend and antibot-backend
# ([B10] / internal/antibotapi). If it is not set, /antibot/v1/* is not
# registered (fail-closed; the dashboard gets a 404). Generated once
# per pool (`openssl rand -hex 32`) and held by both services.
DASHBOARD_API_TOKEN=

# ─── BAC log viewer (Loki + Grafana) ──────────────────────────────────────
# These variables are only consumed when the loki+grafana services are
# brought up via `docker compose --profile observability up -d`. The
# default `docker compose up -d` (catalog + policy + log-receiver) ignores
# them entirely.
#
# Public hostname this LB answers on — used for GF_SERVER_ROOT_URL so
# Grafana emits absolute links that route back through nginx. Defaults to
# the demo CN if unset.
BACKEND_HOST=antibot.internal

# Grafana admin password. STRONGLY RECOMMENDED to set this whenever you
# enable the observability profile — leaving it empty falls back to
# Grafana's built-in `admin/admin` default (which forces a password change
# on first login, so it's not an instant breach, but it's still admin/admin
# until that first login lands). Generate with `openssl rand -hex 24`.
GRAFANA_ADMIN_PASSWORD=

# Optional: serve Grafana with anonymous viewer access (read-only, no
# login). Only enable if you trust the CIDR-allowlist in
# auth/grafana-cidr.conf to gate the URL. Default off.
GF_ANON=false

# ─── BAC analytics (antibot-analytics, observability profile) ──────────────
# Daily traffic analyzer moved off the edge onto the backend (reads Loki).
# Writes state/*.json artifacts for the promotion tooling and emails the report.
# Cron-driven one-shot (scheduled by host cron at 08:00, not an in-container
# loop) — see docs/runbooks/blocklist-promotion.md. All optional: with email
# vars unset the artifacts are still written, only the email is skipped.
BAC_TTL_DAYS=14               # inactivity days → auto-demote candidate
BAC_MIN_STAGING_HOURS=48      # staging observation window before activate
# State rotation (D7, rotate-state.py runs before analyze.py each pass). All
# optional — defaults applied in run.sh. See infra/demo-stand/scripts/README.md.
STATE_FP_TTL_DAYS=30          # archive an fp after N days silent
STATE_IP_TTL_DAYS=7           # archive an IP after N days silent (ASN churns faster)
STATE_COMPACT_MIN_COUNT=3     # count below which an idle (>7d) record is dropped
STATE_ARCHIVE_RETENTION_MONTHS=6  # delete archive shards older than N months (0 = keep)
TZ=Europe/Moscow
# Daily report email via Gmail SMTP (same account the edge used). Leave blank
# to disable email. App-password, not the account password.
REPORT_FROM=
REPORT_TO=
MSMTP_HOST=smtp.gmail.com
MSMTP_PORT=587
MSMTP_USER=
MSMTP_PASS=
