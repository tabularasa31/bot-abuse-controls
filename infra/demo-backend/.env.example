# Copy to .env and fill in. .env is gitignored — never commit real secrets.
POSTGRES_DB=antibot
POSTGRES_USER=antibot
POSTGRES_PASSWORD=

# Shared M2M secret для bearer-auth между dashboard-backend и antibot-backend
# ([B10] / internal/antibotapi). Если не задан — /antibot/v1/* не
# регистрируется (fail-closed; dashboard получит 404). Генерируется один раз
# на пул (`openssl rand -hex 32`), хранится у обоих сервисов.
DASHBOARD_API_TOKEN=

# ─── BAC log viewer (Loki + Grafana) ──────────────────────────────────────
# Public hostname this LB answers on — used for GF_SERVER_ROOT_URL so
# Grafana emits absolute links that route back through nginx. Defaults to
# the demo CN if unset.
BACKEND_HOST=antibot.internal

# Grafana admin password. REQUIRED to bring up the grafana service.
# Generate with `openssl rand -hex 24`. The viewer is also gated by
# auth/grafana-cidr.conf, so loss of this password isn't an instant breach,
# but rotate it on suspicion.
GRAFANA_ADMIN_PASSWORD=

# Optional: serve Grafana with anonymous viewer access (read-only, no
# login). Only enable if you trust the CIDR-allowlist in
# auth/grafana-cidr.conf to gate the URL. Default off.
GF_ANON=false
